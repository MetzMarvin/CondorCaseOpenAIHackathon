# Paste your key here after copying this file to .env. Backend only.
OPENAI_API_KEY=
# auto uses OpenAI when a key is present; offline runs deterministic demo rules.
# openai requires a key and fails explicitly if configuration/API calls fail.
AI_MODE=auto
OPENAI_MODEL=gpt-4o-mini
# Per expert call; three synchronous calls per successful case; no automatic retries.
OPENAI_TIMEOUT_SECONDS=60

# Intake preparation has a separate explicit mode; no decision run is implicit.
CONDOR_PREPARATION_MODE=offline
CONDOR_EXTRACTION_MODEL=gpt-6.1-terra
