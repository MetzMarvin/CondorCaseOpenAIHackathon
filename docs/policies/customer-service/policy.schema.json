{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:condor:customer-service:policy:1.0.0",
  "title": "Customer service policy package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "version",
    "title",
    "language",
    "status",
    "created_on",
    "review_due_on",
    "owner_role",
    "scope",
    "approval",
    "language_profile",
    "precedence",
    "mandatory_rule_ids",
    "table_rule_ids",
    "rules"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "const": "en"
    },
    "status": {
      "enum": [
        "draft_review_required",
        "approved",
        "retired"
      ]
    },
    "created_on": {
      "type": "string",
      "minLength": 1
    },
    "review_due_on": {
      "type": "string",
      "minLength": 1
    },
    "owner_role": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object"
    },
    "approval": {
      "type": "object"
    },
    "language_profile": {
      "type": "object"
    },
    "precedence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mandatory_rule_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "table_rule_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "title",
          "topic",
          "rule_kind",
          "trigger",
          "required_facts",
          "instructions",
          "prohibited_actions",
          "source_refs",
          "related_rule_ids",
          "keywords"
        ],
        "properties": {
          "rule_id": {
            "type": "string",
            "pattern": "^[A-Z]+-[0-9]{3}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "topic": {
            "type": "string",
            "minLength": 1
          },
          "rule_kind": {
            "enum": [
              "operating_control",
              "legal_rule"
            ]
          },
          "trigger": {
            "type": "string",
            "minLength": 1
          },
          "required_facts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "instructions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "prohibited_actions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_id",
                "locator"
              ],
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "related_rule_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "minItems": 1
    }
  }
}
