        </mxCell>
        <mxCell id="e2" value="Messages" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=15;strokeWidth=2;strokeColor=#64748B;fontColor=#334155;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;startArrow=block;startFill=1;exitX=1;exitY=.5;entryX=0;entryY=.85;" edge="1" parent="1" source="email" target="case">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="480" y="470" />
              <mxPoint x="480" y="338" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e3" value="Read / write" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=15;strokeWidth=2;strokeColor=#64748B;fontColor=#334155;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;startArrow=block;startFill=1;exitX=1;exitY=.5;entryX=0;entryY=.5;" edge="1" parent="1" source="case" target="sf">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e4" value="Jobs / case updates" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=15;strokeWidth=2;strokeColor=#64748B;fontColor=#334155;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;startArrow=block;startFill=1;exitX=.5;exitY=1;entryX=.5;entryY=0;" edge="1" parent="1" source="case" target="agent">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e5" value="Work / handoff" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=15;strokeWidth=2;strokeColor=#64748B;fontColor=#334155;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;startArrow=block;startFill=1;exitX=1;exitY=.5;entryX=0;entryY=.75;" edge="1" parent="1" source="staff" target="agent">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e6" value="Configure / approve" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=15;strokeWidth=2;strokeColor=#64748B;fontColor=#334155;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;startArrow=block;startFill=1;exitX=1;exitY=.5;entryX=0;entryY=.3;" edge="1" parent="1" source="admin" target="actions">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e7" value="Retrieve sources" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=15;strokeWidth=2;strokeColor=#64748B;fontColor=#334155;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;startArrow=block;startFill=1;exitX=1;exitY=.2;entryX=0;entryY=.5;" edge="1" parent="1" source="agent" target="kb">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e8" value="Check authority" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=15;strokeWidth=2;strokeColor=#64748B;fontColor=#334155;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;startArrow=block;startFill=1;exitX=1;exitY=.8;entryX=0;entryY=.5;" edge="1" parent="1" source="agent" target="budget">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e9" value="Validated next action" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=15;strokeWidth=2;strokeColor=#64748B;fontColor=#334155;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=.5;exitY=1;entryX=.5;entryY=0;" edge="1" parent="1" source="agent" target="actions">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e10" value="Reserve / book" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=15;strokeWidth=2;strokeColor=#64748B;fontColor=#334155;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;startArrow=block;startFill=1;exitX=1;exitY=.5;entryX=.25;entryY=1;" edge="1" parent="1" source="actions" target="budget">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1435" y="932.5" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e11" value="Save &amp; deliver via channel" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=15;strokeWidth=2;strokeColor=#64748B;fontColor=#334155;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=0;exitY=.7;entryX=0;entryY=.3;" edge="1" parent="1" source="actions" target="case">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="450" y="959.5" />
              <mxPoint x="450" y="258.5" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e12" value="Action events" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=15;strokeWidth=2;strokeColor=#64748B;fontColor=#334155;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;strokeColor=#5B9EAF;exitX=.5;exitY=1;entryX=.5;entryY=0;" edge="1" parent="1" source="actions" target="events">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e13" value="Case / workflow events" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=15;strokeWidth=2;strokeColor=#64748B;fontColor=#334155;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;strokeColor=#5B9EAF;exitX=1;exitY=.85;entryX=1;entryY=.3;" edge="1" parent="1" source="case" target="events">
          <mxGeometry relative="1" as="geometry" x="0.7">
            <Array as="points">
              <mxPoint x="1220" y="338.25" />
              <mxPoint x="1220" y="1116" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e14" value="Live feed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=15;strokeWidth=2;strokeColor=#64748B;fontColor=#334155;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;strokeColor=#5B9EAF;exitX=1;exitY=.65;entryX=0;entryY=.7;" edge="1" parent="1" source="events" target="graph">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e15" value="Metrics" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=15;strokeWidth=2;strokeColor=#64748B;fontColor=#334155;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;strokeColor=#5B9EAF;exitX=1;exitY=.9;entryX=0;entryY=.5;" edge="1" parent="1" source="events" target="metrics">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1250" y="1188" />
              <mxPoint x="1250" y="1272.5" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e16" value="Run evidence" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=15;strokeWidth=2;strokeColor=#64748B;fontColor=#334155;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;strokeColor=#5B9EAF;exitX=.5;exitY=1;entryX=.5;entryY=0;" edge="1" parent="1" source="events" target="eval">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="condor-flow" name="Action and handoff flow">
    <mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="1290" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" value="&lt;b&gt;Condor Care Hub | Action &amp; handoff flow&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=34;fontColor=#304B63;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1500" height="55" as="geometry" />
        </mxCell>
        <mxCell id="s" value="Three outcomes at each step: ask clearly, resolve within authority, or hand off with full context.&lt;br&gt;All replies and financial actions are simulated. Current plan replaces blanket pilot approval." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#304B63;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="83" width="1500" height="50" as="geometry" />
        </mxCell>
        <mxCell id="intake" value="&lt;b&gt;Message or evidence arrives&lt;/b&gt;&lt;br&gt;&lt;br&gt;Email / portal / chat → same case and history&lt;br&gt;Deduplicate • Link customer • Read text / image / PDF" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;spacing=15;fillColor=#E5F4F1;strokeColor=#398B81;fontColor=#172B4D;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="560" y="180" width="480" height="115" as="geometry" />
        </mxCell>
        <mxCell id="triage" value="&lt;b&gt;Reassess the whole case&lt;/b&gt;&lt;br&gt;&lt;br&gt;Facts, all issues, severity and supported capabilities&lt;br&gt;Separate permission to ask from permission to decide&lt;br&gt;Check again after new evidence and before each action" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;spacing=15;fillColor=#E5F4F1;strokeColor=#398B81;fontColor=#172B4D;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="560" y="355" width="480" height="155" as="geometry" />
        </mxCell>
        <mxCell id="ask" value="&lt;b&gt;Clear, necessary question&lt;/b&gt;&lt;br&gt;&lt;br&gt;Check existing facts first&lt;br&gt;Ask automatically through the current channel&lt;br&gt;No human approval for supported clarification" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;spacing=15;fillColor=#E5F4F1;strokeColor=#398B81;fontColor=#172B4D;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="610" width="400" height="145" as="geometry" />
        </mxCell>
        <mxCell id="gate" value="&lt;b&gt;Decision &amp; action checks&lt;/b&gt;&lt;br&gt;&lt;br&gt;Complete, consistent facts • Applicable approved rules&lt;br&gt;Validate amounts, response quality and authority&lt;br&gt;Model confidence alone is insufficient" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;spacing=15;fillColor=#E5F4F1;strokeColor=#398B81;fontColor=#172B4D;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="560" y="610" width="480" height="145" as="geometry" />
        </mxCell>
        <mxCell id="handoff" value="&lt;b&gt;Prepared human handoff&lt;/b&gt;&lt;br&gt;&lt;br&gt;Unsupported action, serious issue, unresolved conflict,&lt;br&gt;unclear rules, authority limit or persistent failure&lt;br&gt;Facts, sources, history, prior attempts and reason" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;spacing=15;fillColor=#FFF2DC;strokeColor=#C69840;fontColor=#172B4D;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1160" y="610" width="400" height="180" as="geometry" />
        </mxCell>
        <mxCell id="wait" value="&lt;b&gt;Wait for customer&lt;/b&gt;&lt;br&gt;&lt;br&gt;AI keeps ownership&lt;br&gt;Reply / upload resumes triage on the same case&lt;br&gt;No progress after configured limit → handoff" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;spacing=15;fillColor=#E5F4F1;strokeColor=#398B81;fontColor=#172B4D;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="865" width="400" height="145" as="geometry" />
        </mxCell>
        <mxCell id="resolve" value="&lt;b&gt;Simulate reply &amp; resolution&lt;/b&gt;&lt;br&gt;&lt;br&gt;Supported cases: automatic decision and demo reply&lt;br&gt;Human cases: reviewed decision and demo reply&lt;br&gt;Required exception approval must be recorded" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;spacing=15;fillColor=#E5F4F1;strokeColor=#398B81;fontColor=#172B4D;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="560" y="865" width="480" height="145" as="geometry" />
        </mxCell>
        <mxCell id="human" value="&lt;b&gt;Specialist / authorized approver&lt;/b&gt;&lt;br&gt;&lt;br&gt;Take exclusive ownership; stop stale AI sends&lt;br&gt;Resolve, clarify or reassign with full context&lt;br&gt;Budget exception: obtain the required approval" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;spacing=15;fillColor=#FFF2DC;strokeColor=#C69840;fontColor=#172B4D;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1160" y="865" width="400" height="145" as="geometry" />
        </mxCell>
        <mxCell id="closed" value="&lt;b&gt;Record outcome → resolved / closed&lt;/b&gt;&lt;br&gt;&lt;br&gt;New relevant information can reopen the same case" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;spacing=15;fillColor=#E5F4F1;strokeColor=#398B81;fontColor=#172B4D;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="560" y="1085" width="480" height="95" as="geometry" />
        </mxCell>
        <mxCell id="note1" value="&lt;b&gt;FINANCIAL POSITIONS&lt;/b&gt;&lt;br&gt;Compensation, ticket / expense reimbursement and voluntary goodwill remain distinct.&lt;br&gt;Goodwill budget never caps a statutory claim." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontColor=#304B63;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="1080" width="440" height="110" as="geometry" />
        </mxCell>
        <mxCell id="note2" value="&lt;b&gt;OBSERVE EVERY TRANSITION&lt;/b&gt;&lt;br&gt;Case, step, owner, reason and time feed the live graph, audit history and metrics." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontColor=#304B63;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1160" y="1080" width="400" height="110" as="geometry" />
        </mxCell>
        <mxCell id="foot" value="Negative sentiment or multiple supported issues alone do not trigger handoff. Customer replies always trigger a fresh eligibility check." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#304B63;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="1220" width="1510" height="35" as="geometry" />
        </mxCell>
