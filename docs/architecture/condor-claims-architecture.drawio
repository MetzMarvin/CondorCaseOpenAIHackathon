<mxfile host="app.diagrams.net">
  <diagram id="condor-claims" name="Architecture">
    <mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1800" pageHeight="1490" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;Condor Care Hub | Claims architecture&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=34;fontColor=#304B63;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1720" height="50" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Updated from hackathon-plan.md • Technology-neutral logical components&lt;br&gt;All customers, messages, payments and internal policies are synthetic or simulated." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#304B63;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="78" width="1700" height="55" as="geometry" />
        </mxCell>
        <mxCell id="hc" value="&lt;b&gt;CHANNELS &amp; WORKSPACES&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#304B63;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="155" width="380" height="30" as="geometry" />
        </mxCell>
        <mxCell id="hb" value="&lt;b&gt;AGENT BACKEND&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#304B63;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="580" y="155" width="560" height="30" as="geometry" />
        </mxCell>
        <mxCell id="hd" value="&lt;b&gt;SHARED RECORDS &amp; CONTROLS&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#304B63;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1330" y="155" width="420" height="30" as="geometry" />
        </mxCell>
        <mxCell id="portal" value="&lt;b&gt;Customer portal &amp; account mock&lt;/b&gt;&lt;br&gt;&lt;br&gt;Form / chat • Image and PDF uploads&lt;br&gt;Bookings • My cases • Status&lt;br&gt;Email users can use an upload link" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;spacing=15;fillColor=#EAF3FF;strokeColor=#6C97C7;fontColor=#172B4D;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="215" width="360" height="145" as="geometry" />
        </mxCell>
        <mxCell id="email" value="&lt;b&gt;Email simulator&lt;/b&gt;&lt;br&gt;&lt;br&gt;Inbox and demo outbox&lt;br&gt;Attachments and threaded replies&lt;br&gt;No real customer messages" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;spacing=15;fillColor=#EAF3FF;strokeColor=#6C97C7;fontColor=#172B4D;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="405" width="360" height="130" as="geometry" />
        </mxCell>
        <mxCell id="staff" value="&lt;b&gt;Service console&lt;/b&gt;&lt;br&gt;&lt;br&gt;Queues, ownership, deadlines and priority&lt;br&gt;Full case history and handoff package&lt;br&gt;Manual decisions and exception approvals" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;spacing=15;fillColor=#FFF2DC;strokeColor=#C69840;fontColor=#172B4D;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="625" width="360" height="155" as="geometry" />
        </mxCell>
        <mxCell id="admin" value="&lt;b&gt;Team &amp; knowledge workspace&lt;/b&gt;&lt;br&gt;&lt;br&gt;Routing, capability and policy settings&lt;br&gt;Budget / disruption approvals&lt;br&gt;Review corrections before rule changes" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;spacing=15;fillColor=#FFF2DC;strokeColor=#C69840;fontColor=#172B4D;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="835" width="360" height="135" as="geometry" />
        </mxCell>
        <mxCell id="case" value="&lt;b&gt;Shared intake &amp; case service&lt;/b&gt;&lt;br&gt;&lt;br&gt;Normalize messages • Match threads • Prevent duplicates&lt;br&gt;Store original evidence and source-linked facts&lt;br&gt;Case state, ownership, version checks and reopen / resume" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;spacing=15;fillColor=#E5F4F1;strokeColor=#398B81;fontColor=#172B4D;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="580" y="215" width="560" height="145" as="geometry" />
        </mxCell>
        <mxCell id="agent" value="&lt;b&gt;Orchestrated AI workflow&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Evidence &amp; triage&lt;/b&gt;&lt;br&gt;Read text / images / PDFs • Identify all issues&lt;br&gt;Assess completeness, severity and sentiment&lt;br&gt;&lt;br&gt;&lt;b&gt;Rules-based routing &amp; assignments&lt;/b&gt;&lt;br&gt;Capability, authority, category, language, deadline, capacity&lt;br&gt;One active owner • Separate business queues from AI jobs&lt;br&gt;&lt;br&gt;&lt;b&gt;Research, clarify &amp; resolve&lt;/b&gt;&lt;br&gt;Retrieve sources • Ask clear questions automatically&lt;br&gt;Validate facts, rules, response quality and authority&lt;br&gt;Resolve supported cases or prepare a human handoff" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;spacing=15;fillColor=#E5F4F1;strokeColor=#398B81;fontColor=#172B4D;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="580" y="425" width="560" height="370" as="geometry" />
        </mxCell>
        <mxCell id="actions" value="&lt;b&gt;Action control &amp; simulated fulfilment&lt;/b&gt;&lt;br&gt;&lt;br&gt;Recheck eligibility, authority and current owner before action&lt;br&gt;Auto-send when checks pass; special approval when required&lt;br&gt;Demo outbox • Budget reservations / bookings • Safe retries" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;spacing=15;fillColor=#E5F4F1;strokeColor=#398B81;fontColor=#172B4D;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="580" y="865" width="560" height="135" as="geometry" />
        </mxCell>
        <mxCell id="sf" value="&lt;b&gt;Salesforce-style shared mock&lt;/b&gt;&lt;br&gt;&lt;br&gt;Accounts, contacts, bookings and flight facts&lt;br&gt;Cases, messages, documents, queues, owners&lt;br&gt;Decisions, approvals and AI-run records" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;spacing=15;fillColor=#F0EDF9;strokeColor=#9782B9;fontColor=#172B4D;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1330" y="215" width="420" height="145" as="geometry" />
        </mxCell>
        <mxCell id="kb" value="&lt;b&gt;Versioned knowledge&lt;/b&gt;&lt;br&gt;&lt;br&gt;Approved regulations and interpretation&lt;br&gt;DEMO policies and reviewed examples&lt;br&gt;Source, validity, language and version" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;spacing=15;fillColor=#F0EDF9;strokeColor=#9782B9;fontColor=#172B4D;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1330" y="425" width="420" height="145" as="geometry" />
        </mxCell>
        <mxCell id="budget" value="&lt;b&gt;Authority, budgets &amp; disruptions&lt;/b&gt;&lt;br&gt;&lt;br&gt;Delegated limits and exceptional approvals&lt;br&gt;Time-bound disruption rules and goodwill pools&lt;br&gt;Separate compensation, expenses and goodwill&lt;br&gt;Reservations and simulated financial ledger" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;spacing=15;fillColor=#F0EDF9;strokeColor=#9782B9;fontColor=#172B4D;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1330" y="635" width="420" height="160" as="geometry" />
        </mxCell>
        <mxCell id="events" value="&lt;b&gt;Event history &amp; measurement&lt;/b&gt;&lt;br&gt;&lt;br&gt;Case / step / owner / time / status / safe payload summary&lt;br&gt;Workflow, action, tool, queue and error events&lt;br&gt;Persisted history supports live updates and replay" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;spacing=15;fillColor=#E8F6FA;strokeColor=#5B9EAF;fontColor=#172B4D;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="580" y="1080" width="560" height="120" as="geometry" />
        </mxCell>
        <mxCell id="graph" value="&lt;b&gt;Live process graph&lt;/b&gt;&lt;br&gt;&lt;br&gt;Read-only pitch frontend&lt;br&gt;Active nodes / edges • Case timeline • Replay&lt;br&gt;Waiting, completion, failure and handoff states" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;spacing=15;fillColor=#E8F6FA;strokeColor=#5B9EAF;fontColor=#172B4D;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1330" y="1035" width="420" height="125" as="geometry" />
        </mxCell>
        <mxCell id="metrics" value="&lt;b&gt;Operations &amp; quality dashboard&lt;/b&gt;&lt;br&gt;&lt;br&gt;Backlog, deadlines, sentiment and queue times&lt;br&gt;Human effort, AI cost, routing and quality&lt;br&gt;Distinguish simulated from measured results" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;spacing=15;fillColor=#E8F6FA;strokeColor=#5B9EAF;fontColor=#172B4D;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1330" y="1210" width="420" height="125" as="geometry" />
        </mxCell>
        <mxCell id="eval" value="&lt;b&gt;Synthetic scenarios &amp; offline evaluation&lt;/b&gt;&lt;br&gt;&lt;br&gt;Planned: 3,000 cases • 2,100 dev / 450 validation / 450 test&lt;br&gt;Hidden test labels • Reviewed references • Versioned changes&lt;br&gt;Seed the mock; compare run results with held-out references" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;spacing=15;fillColor=#F5F6F8;strokeColor=#9CA7B4;fontColor=#172B4D;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="580" y="1275" width="560" height="125" as="geometry" />
        </mxCell>
        <mxCell id="stretch" value="&lt;b&gt;STRETCH CHANNELS&lt;/b&gt;&lt;br&gt;Messenger and voice / transcript simulators" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#304B63;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="1025" width="380" height="65" as="geometry" />
        </mxCell>
        <mxCell id="rules" value="&lt;b&gt;OPERATING RULES&lt;/b&gt;&lt;br&gt;&lt;br&gt;Clear questions do not require human approval.&lt;br&gt;&lt;br&gt;Missing data, multiple issues or negative sentiment alone do not trigger handoff.&lt;br&gt;&lt;br&gt;Sentiment affects tone and limited priority; never the claim amount." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#304B63;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="1145" width="410" height="225" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="&lt;b&gt;Shared safeguards:&lt;/b&gt; role-based access • attachments are data, not instructions • source traceability • duplicate prevention • manual fallback" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#304B63;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="1430" width="1700" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="Claims / status" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=15;strokeWidth=2;strokeColor=#64748B;fontColor=#334155;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;startArrow=block;startFill=1;exitX=1;exitY=.5;entryX=0;entryY=.5;" edge="1" parent="1" source="portal" target="case">
          <mxGeometry relative="1" as="geometry">
